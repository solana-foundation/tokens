{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BIRDEYE_API_KEY",
        "CLERK_SECRET_KEY",
        "COINGECKO_API_KEY",
        "DD_API_KEY",
        "OPENAI_API_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "TOKENS_CLOUDRUN_ASSETS_URL",
        "TOKENS_CLOUDRUN_PRICES_URL",
        "TOKENS_CLOUDRUN_USAGE_URL",
        "TOKENS_CLOUDRUN_ADMIN_URL",
        "TOKENS_CLOUDRUN_AUTH_TOKEN",
        "TOKENS_IDENTITY_SIGNING_SECRET",
        "TOKENS_ADMIN_CLERK_USER_IDS",
        "TOKENS_ADMIN_EMAILS",
        "API_BASE_URL",
        "TOKENS_API_ORIGIN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": ["*.tsbuildinfo", "dist/*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "BIRDEYE_API_KEY",
        "CLERK_SECRET_KEY",
        "COINGECKO_API_KEY",
        "DD_API_KEY",
        "OPENAI_API_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "TOKENS_CLOUDRUN_ASSETS_URL",
        "TOKENS_CLOUDRUN_PRICES_URL",
        "TOKENS_CLOUDRUN_USAGE_URL",
        "TOKENS_CLOUDRUN_ADMIN_URL",
        "TOKENS_CLOUDRUN_AUTH_TOKEN",
        "TOKENS_IDENTITY_SIGNING_SECRET",
        "TOKENS_ADMIN_CLERK_USER_IDS",
        "TOKENS_ADMIN_EMAILS",
        "API_BASE_URL",
        "TOKENS_API_ORIGIN"
      ]
    },
    "clean": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    }
  }
}

# Shared Clerk auth
# Use one issuer, or a comma-separated list when accepting multiple Clerk apps.
CLERK_JWT_ISSUER_DOMAIN=

# Cloud Run backend (GCP). Operator scripts in scripts/ call these
# bearer-authed services (see scripts/_cloudrun.mjs).
TOKENS_CLOUDRUN_ENABLED=true
TOKENS_CLOUDRUN_ASSETS_URL=
TOKENS_CLOUDRUN_ADMIN_URL=
TOKENS_CLOUDRUN_PRICES_URL=
TOKENS_CLOUDRUN_USAGE_URL=
TOKENS_CLOUDRUN_AUTH_TOKEN=

# Cloud Run /jobs/* invocation (OIDC, see scripts/_jobs.mjs). Either paste a
# ready identity token, or set the invoker service account to impersonate
# via gcloud.
TOKENS_CLOUDRUN_JOBS_ID_TOKEN=
TOKENS_CLOUDRUN_JOBS_INVOKER_SA=

# GCS logo bucket used by scripts/upload-asset-logo.mjs and
# scripts/populate-asset-logos.mjs (public base URL is optional and defaults
# to https://storage.googleapis.com/<bucket>).
GCS_LOGO_BUCKET=
GCS_LOGO_PUBLIC_BASE_URL=

# Shared operational/auth settings
TOKENS_API_KEY_ENCRYPTION_SECRET=
TOKENS_PLAYGROUND_PROXY_SECRET=
TOKENS_ADMIN_CLERK_USER_IDS=
CLERK_AUTHORIZED_PARTIES=

# Shared provider credentials used by maintenance scripts
BIRDEYE_API_KEY=
COINGECKO_API_KEY=
DD_API_KEY=
# Required for Jupiter Swap V2 quote comparison on /v2/execution/evaluate.
# Token metadata can still use Jupiter Lite when this is unset.
JUPITER_API_KEY=
OPENAI_API_KEY=
RWA_API_KEY=
SANCTUM_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ClickHouse cache refresh jobs. Keep Solana trades disabled until the target
# deployment has been validated.
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_REQUEST_TIMEOUT_MS=180000
CLICKHOUSE_SOLANA_TRADES_TABLE=trades_anza_final
CLICKHOUSE_SOLANA_TRADES_REFRESH_ENABLED=false

# Depth-sampling job (variant_depth_curves_latest ← Titan quote API).
# Keep disabled until curves are validated against live quotes.
TITAN_WS_URL=
TITAN_API_KEY=

# Titan REST (live quote comparison on /v2/execution/evaluate). Separate
# transport and auth scheme from the WebSocket depth client above, so it gets
# its own credential; TITAN_REST_API_KEY falls back to TITAN_API_KEY.
# TITAN_REST_BASE_URL is REQUIRED to enable Titan comparison: the built-in
# default points at Titan's demo cluster, so it is never used implicitly.
# Set TITAN_REST_ALLOW_DEMO=true in local dev to opt into the demo cluster.
TITAN_REST_BASE_URL=
TITAN_REST_API_KEY=
TITAN_REST_ALLOW_DEMO=false
# Quote-only wallet Titan prices against (never signs). Defaults to a fixed
# placeholder key; override only if Titan requires a real account.
TITAN_QUOTE_USER_PUBLIC_KEY=
DEPTH_REFRESH_ENABLED=false
# Which sampled source the (currently parked) depth read path trusts: titan or jupiter_lite.
DEPTH_READ_SOURCE=titan

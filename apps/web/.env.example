# Canonical site origin (used for metadataBase / share URLs)
NEXT_PUBLIC_SITE_URL=https://tokens.xyz

# Public analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_DEBUG=

# Platform API proxy configuration
# API_BASE_URL takes precedence over TOKENS_API_ORIGIN when set.
API_BASE_URL=
TOKENS_API_ORIGIN=
TOKENS_PLATFORM_API_KEY=

# Optional additional hosts for remote image/dominant-color fetching
TOKENS_IMAGE_PROXY_ALLOWED_HOSTS=

# Server-side provider credentials used by web routes
COINGECKO_API_KEY=
DD_API_KEY=
# Pyth Pro API key (server-only). Mints short-lived browser tokens for the live price stream
# and resolves tickers to Pyth feeds. Without it live prices fall back to the last snapshot.
PYTH_API_KEY=
# Upstash Redis (REST) backing the rate limits on /api/realtime/*; shared with the API app. Optional:
# without it the limits are enforced per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dedicated Pinata gateway for ipfs:// logos served via /api/image-proxy (public gateways rate-limit)
PINATA_GATEWAY_HOST=
PINATA_GATEWAY_TOKEN=

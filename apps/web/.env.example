# apps/web — every environment variable the app reads. All are optional: with
# none of them set the app runs against public market data instead of the
# Tokens platform API, which is what local development normally wants.

# --------------------------------------------------------------- Platform API
# The Tokens platform API behind /api/v1/*. Without both of these the proxy
# routes fail and the app falls back to public sources (see
# src/lib/market-data/curated-fallback.ts).
# API_BASE_URL=http://localhost:3002
# TOKENS_PLATFORM_API_KEY=

# ------------------------------------------------------------------ CoinGecko
# Pro key. Also used for the on-chain DEX endpoints behind /dex and the
# homepage liquidity sweep, which run against GeckoTerminal's keyless tier
# otherwise — that tier rejects roughly half of all calls even at six-second
# spacing, so /dex shows one page per chain instead of several.
# COINGECKO_API_KEY=

# Free Demo key (30 calls/min). Used only when no Pro key is set.
# COINGECKO_DEMO_API_KEY=

# ---------------------------------------------------------------------- Misc
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_DEBUG=
# BINANCE_API_URL=
# Comma-separated extra hosts the image proxy will fetch from.
# TOKENS_IMAGE_PROXY_ALLOWED_HOSTS=

# ------------------------------------------------------- Status page (Grafana)
# TOKENS_STATUS_LOKI_URL=
# TOKENS_STATUS_LOKI_USER=
# TOKENS_STATUS_LOKI_TOKEN=

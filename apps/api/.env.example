# Clerk auth for session-protected routes
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=

# Rate limiting / caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TOKENS_CACHE_WARM_SECRET=
TOKENS_PLAYGROUND_PROXY_SECRET=
TOKENS_API_KEY_ENCRYPTION_SECRET=
# Default per-key limits applied when a key has no explicit override. The
# fallbacks below preserve permissive "launch mode"; set real values before
# offering the API externally.
TOKENS_DEFAULT_RATE_LIMIT_REQUESTS=100000
TOKENS_DEFAULT_RATE_LIMIT_WINDOW_SECONDS=10
TOKENS_DEFAULT_QUOTA_PER_MONTH=1000000000

# Cloud Run backend (required)
TOKENS_CLOUDRUN_AUTH_TOKEN=
TOKENS_CLOUDRUN_ASSETS_URL=
TOKENS_CLOUDRUN_PRICES_URL=
TOKENS_CLOUDRUN_USAGE_URL=
# Optional — admin service stays IAM-locked unless set.
TOKENS_CLOUDRUN_ADMIN_URL=

# Upstream providers used by API routes
BIRDEYE_API_KEY=
COINGECKO_API_KEY=
DD_API_KEY=
OPENAI_API_KEY=
RWA_API_KEY=
# Optional. Live risk reads (mints with no market snapshot) allowed per API key
# per provider budget window (10 minutes). Defaults to 60.
# TOKEN_RISK_PROVIDER_CALLS_PER_WINDOW=60

# X API app-only auth for the @tokens feed. Prefer X_BEARER_TOKEN; X_API_KEY/X_API_SECRET
# are used to derive an app-only bearer token when X_BEARER_TOKEN is not set.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# ClickHouse stock data. Keep disabled until mappings and sample assets have
# been validated in the target deployment.
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_REQUEST_TIMEOUT_MS=180000
CLICKHOUSE_STOCK_TRADES_TABLE=
# Optional. If set, canonical stock chart refresh uses BBO quotes before falling back to trades.
CLICKHOUSE_STOCK_BBO_TABLE=
# Optional. Override BBO price expression when the table does not use price or bid/ask columns.
CLICKHOUSE_STOCK_BBO_PRICE_EXPR=
# Optional. If unset, stock mapping sync derives symbols from CLICKHOUSE_STOCK_TRADES_TABLE.
CLICKHOUSE_STOCK_INSTRUMENTS_TABLE=
CLICKHOUSE_STOCK_TS_EVENT_TYPE=unix_nanos
CLICKHOUSE_STOCK_PRICE_SCALE=1
CLICKHOUSE_STOCK_REFRESH_ENABLED=false

CLICKHOUSE_SOLANA_TRADES_TABLE=trades_anza_final
CLICKHOUSE_SOLANA_TRADES_REFRESH_ENABLED=false

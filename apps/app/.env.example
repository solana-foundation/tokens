# Clerk auth for the dashboard app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Dashboard backend: GCP Cloud Run usage service
TOKENS_CLOUDRUN_USAGE_URL=
TOKENS_CLOUDRUN_AUTH_TOKEN=

# Optional API proxy overrides for self-hosting
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
TOKENS_API_BASE_URL=
TOKENS_API_ORIGIN=
TOKENS_PLAYGROUND_PROXY_SECRET=
# HMAC key for the signed x-tokens-identity token sent to the usage service.
# Must match the usage service's TOKENS_IDENTITY_SIGNING_SECRET.
TOKENS_IDENTITY_SIGNING_SECRET=

{
  "uid": "tokens-coin-list-sync-unhealthy",
  "title": "tokens-assets: CoinGecko coin-list sync unhealthy",
  "ruleGroup": "tokens-crons",
  "folderUID": "tokens",
  "noDataState": "OK",
  "execErrState": "OK",
  "for": "0s",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "tokens-logs",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 3600,
        "to": 0
      },
      "model": {
        "expr": "sum(count_over_time({service=\"tokens-assets-prd-us\"} |~ \"\\\\[syncCoingeckoCoinList\\\\] batch failed|failing open \\\\(is the coin-list sync healthy\\\\?\\\\)\" [1h]))",
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "labels": {
    "service": "tokens-assets",
    "severity": "warning",
    "pagerduty": "false",
    "slack": "true"
  },
  "annotations": {
    "summary": "CoinGecko coin-list sync failing or freshness filter failing open",
    "description": "The weekly sync-coingecko-coin-list cron logged batch failures, or a curated refresh hit the coin-list fail-open path (zero fresh rows). This is the upstream canary for the coingecko provider-error alert: a starved freshness filter re-requests delisted coin ids until the 404 storm trips the 30% error-rate page.",
    "runbook_url": "https://example.com/runbooks/coingecko-coin-list-sync-unhealthy"
  },
  "notification_settings": {
    "receiver": "tokens-slack",
    "group_by": [
      "grafana_folder",
      "alertname"
    ],
    "group_wait": "30s",
    "group_interval": "5m",
    "repeat_interval": "4h"
  }
}

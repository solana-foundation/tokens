{
    "uid": "tokens-stablecoin-depeg-critical",
    "title": "tokens-assets: stablecoin entered Webacy depeg tier CRITICAL",
    "ruleGroup": "tokens-stablecoin-depeg",
    "folderUID": "tokens-xyz",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "0s",
    "data": [
        {
            "refId": "A",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "range",
            "relativeTimeRange": {
                "from": 900,
                "to": 0
            },
            "model": {
                "expr": "sum(count_over_time({service=~\"tokens-assets(-jobs)?-prd-us\"} | json | event=\"depeg_tier_changed\" | observer!=\"peg_guard\" | new_tier=\"critical\" [15m]))",
                "queryType": "range",
                "refId": "A"
            }
        },
        {
            "refId": "B",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "B",
                "expression": "A",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "C",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "threshold",
                "refId": "C",
                "expression": "B",
                "conditions": [
                    {
                        "evaluator": {
                            "type": "gt",
                            "params": [0]
                        },
                        "operator": {
                            "type": "and"
                        },
                        "query": {
                            "params": ["B"]
                        },
                        "reducer": {
                            "type": "last",
                            "params": []
                        },
                        "type": "query"
                    }
                ]
            }
        }
    ],
    "condition": "C",
    "labels": {
        "service": "tokens-assets",
        "severity": "critical",
        "pagerduty": "true",
        "slack": "true"
    },
    "annotations": {
        "summary": "A tracked stablecoin moved to Webacy depeg tier critical",
        "description": "The depeg pipeline observed a tracked Solana stablecoin (registry mint or currencies list member) enter tier critical (Webacy depeg score >= 70) in the last 15 minutes. The log line (event: depeg_tier_changed) carries mint, symbol, old_tier, deviation_pct, price_usd and source (webhook / sweep / manual). If WEBACY_DEPEG_DRY_RUN is false a caution advisory has been set automatically (see the stablecoin-depeg-advisory-changed alert); otherwise decide whether to set one by hand in the admin app. Verify redemptions and liquidity, then post the depeg notice from the runbook.",
        "runbook_url": "https://github.com/solana-foundation/tokens/blob/main/docs/operations/asset-advisory-runbook.md#automated-depeg-advisories"
    }
}

{
  "uid": "tokens-api-smoke-canary-stale",
  "title": "tokens-api: smoke canary hasn't reported in ~5m",
  "ruleGroup": "tokens-api",
  "folderUID": "tokens",
  "noDataState": "Alerting",
  "execErrState": "OK",
  "for": "3m",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "tokens-logs",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "model": {
        "expr": "sum(count_over_time({service=\"tokens-smoke\", target=\"prod\"} [5m]))",
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "lt",
              "params": [
                1
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "labels": {
    "service": "tokens-api",
    "severity": "critical",
    "pagerduty": "true",
    "slack": "true"
  },
  "annotations": {
    "summary": "tokens.xyz API smoke canary stopped reporting",
    "description": "No smoke_canary_summary events from tokens-ci-runner in the last 5 minutes. Either the runner is down, the timer unit isn't firing, or the script crashed before reaching the Loki push. The main API may still be up \u2014 but we've lost the heartbeat that would tell us if it went down. SSH the runner and check `systemctl status tokens-api-health.timer` and `journalctl -u tokens-api-health.service -n 50`.",
    "runbook_url": "https://example.com/runbooks/api-smoke-canary-stale"
  },
  "notification_settings": {
    "receiver": "tokens-critical",
    "group_by": [
      "grafana_folder",
      "alertname"
    ],
    "group_wait": "30s",
    "group_interval": "5m",
    "repeat_interval": "4h"
  }
}

{
  "uid": "tokens-external-provider-latency-high",
  "title": "External provider p95 latency > 5s for 10m",
  "ruleGroup": "tokens-external-providers",
  "folderUID": "tokens-xyz",
  "noDataState": "OK",
  "execErrState": "OK",
  "for": "10m",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "grafanacloud-logs",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "model": {
        "expr": "avg(quantile_over_time(0.95, {service=~\"tokens-.+\"} | json | event=\"external_call\" | provider!~\"logo_.*\" | unwrap duration_ms [5m]))",
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                5000
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "labels": {
    "scope": "external",
    "severity": "warning",
    "pagerduty": "false",
    "slack": "true"
  },
  "annotations": {
    "summary": "External provider p95 latency above 5s",
    "description": "At least one external provider's p95 latency exceeded 5000ms continuously for the last 10 minutes (rule fires after for=10m sustained). Check the External providers dashboard to identify which provider is slow. Excludes logo-sync probes (provider=logo_*), whose 10s per-attempt timeouts against dead artwork URLs are expected.",
    "runbook_url": "https://example.com/runbooks/external-provider-latency-high"
  }
}

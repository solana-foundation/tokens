{
    "uid": "tokens-assets-v2-evm-markets-silent",
    "title": "tokens-assets: no EVM v2 variant market refreshed in 45m",
    "ruleGroup": "tokens-assets-availability",
    "folderUID": "tokens",
    "noDataState": "Alerting",
    "execErrState": "OK",
    "for": "0s",
    "data": [
        {
            "refId": "A",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "instant",
            "relativeTimeRange": {
                "from": 2700,
                "to": 0
            },
            "model": {
                "expr": "sum(count_over_time({service=~\"tokens-assets(-jobs)?-prd-us\"} | json | job=\"refresh-v2-evm-variant-markets\" | event=\"v2_evm_markets_refresh\" | refreshed > 0 [45m]))",
                "queryType": "instant",
                "instant": true,
                "range": false,
                "refId": "A"
            }
        },
        {
            "refId": "B",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "B",
                "expression": "A",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "D",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "instant",
            "relativeTimeRange": {
                "from": 600,
                "to": 0
            },
            "model": {
                "expr": "max(max_over_time({service=\"tokens-logs-pipeline\", env=\"prd\"} | json | event=\"gcp_logs_push\" | unwrap lag_s [10m]))",
                "queryType": "instant",
                "instant": true,
                "range": false,
                "refId": "D"
            }
        },
        {
            "refId": "E",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "E",
                "expression": "D",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "C",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "math",
                "refId": "C",
                "expression": "$B < 1 && $E < 600"
            }
        }
    ],
    "condition": "C",
    "labels": {
        "service": "tokens-assets",
        "severity": "warning",
        "slack": "true"
    },
    "notification_settings": {
        "receiver": "tokens-slack",
        "group_by": ["grafana_folder", "alertname"],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h"
    },
    "annotations": {
        "summary": "refresh-v2-evm-variant-markets has not written a single EVM market row in 45 minutes",
        "description": "No v2_evm_markets_refresh summary with refreshed > 0 from refresh-v2-evm-variant-markets in the 45 minutes before the evaluation (three 15-minute ticks; an instant query, so a positive count earlier in a range could not keep the rule quiet). The chain-down rule only fires when a run attempts a chain and fails, so it is blind to a scheduler that stops firing, a run that returns early with processed:0, or Birdeye returning empty for every row (those are touched, which bumps overviewLastFetchedAt but leaves the served lastFetchedAt where it was). Check the Cloud Scheduler run history for tokens-refresh-v2-evm-variant-markets-prd (404 v2_assets_jobs_disabled = BIRDEYE_API_KEY missing on the worker), then the external_call lines with provider=birdeye. /api/v2 keeps serving the last snapshot, so this is EVM staleness, not an outage; Solana rows are refreshed by v1 and mirrored separately. Suppressed while tokens-logs-pipeline-lagging fires (Cloud Logging → Loki ingestion more than 10 minutes behind): the lines may simply not have reached Loki yet; confirm the run in Cloud Logging before treating this as a job outage.",
        "runbook_url": "https://github.com/solana-foundation/tokens/blob/main/docs/operations/v2-multichain-assets.md"
    }
}

{
    "uid": "tokens-stablecoin-structural-downgrade",
    "title": "tokens-assets: Webacy structural health grade dropped 2+ steps or to D/F",
    "ruleGroup": "tokens-stablecoin-depeg",
    "folderUID": "tokens-xyz",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "0s",
    "data": [
        {
            "refId": "A",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "range",
            "relativeTimeRange": {
                "from": 86400,
                "to": 0
            },
            "model": {
                "expr": "sum(count_over_time({service=~\"tokens-assets(-jobs)?-prd-us\"} | json | event=\"structural_health_grade_changed\" | steps >= 2 [24h])) + sum(count_over_time({service=~\"tokens-assets(-jobs)?-prd-us\"} | json | event=\"structural_health_grade_changed\" | new_grade=~\"D[+-]?|F\" [24h]))",
                "queryType": "range",
                "refId": "A"
            }
        },
        {
            "refId": "B",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "B",
                "expression": "A",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "C",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "threshold",
                "refId": "C",
                "expression": "B",
                "conditions": [
                    {
                        "evaluator": {
                            "type": "gt",
                            "params": [0]
                        },
                        "operator": {
                            "type": "and"
                        },
                        "query": {
                            "params": ["B"]
                        },
                        "reducer": {
                            "type": "last",
                            "params": []
                        },
                        "type": "query"
                    }
                ]
            }
        }
    ],
    "condition": "C",
    "labels": {
        "service": "tokens-assets",
        "severity": "warning",
        "slack": "true"
    },
    "annotations": {
        "summary": "A tracked stablecoin's Webacy structural health grade was downgraded",
        "description": "The daily refresh-stablecoin-structural-health job recorded a composite grade change (event: structural_health_grade_changed) that either dropped two or more steps (steps >= 2 on the A+ .. F scale) or landed on a D or F grade. Fields: mint, symbol, old_grade, new_grade, old_score, new_score. Structural grades have no ranking impact and never set advisories automatically; review the category breakdown (webacy_structural_health_latest.category_scores) and decide whether a manual caution is warranted.",
        "runbook_url": "https://github.com/solana-foundation/tokens/blob/main/docs/operations/asset-advisory-runbook.md#automated-depeg-advisories"
    }
}

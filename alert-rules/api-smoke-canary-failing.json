{
  "uid": "tokens-api-smoke-canary-failing",
  "title": "tokens-api: smoke canary failed twice in a row",
  "ruleGroup": "tokens-api",
  "folderUID": "tokens",
  "noDataState": "OK",
  "execErrState": "OK",
  "for": "0s",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "tokens-logs",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 180,
        "to": 0
      },
      "model": {
        "expr": "sum(count_over_time({service=\"tokens-smoke\", target=\"prod\"} | json | failed_any=\"true\" [3m]))",
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gte",
              "params": [
                2
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "labels": {
    "service": "tokens-api",
    "severity": "critical",
    "pagerduty": "true",
    "slack": "true"
  },
  "annotations": {
    "summary": "tokens.xyz smoke canary (API + public web pages) failed 2+ times in 3 minutes",
    "description": "The minute-cadence smoke canary on tokens-ci-runner has reported 2 or more failed runs in the last 3 minutes. It probes the Tokens API and, for prod, the public site's data pages (/, /registry, /heatmap), which fail when they render their \"temporarily unavailable\" panel even though the HTTP status is 200. Check the most recent Slack alert or the smoke_canary_summary line in Loki ({service=\"tokens-smoke\"}) for which probes failed: [api] probes mean the API is down or degraded, [web] probes mean tokens.xyz is serving a broken page (check the Vercel logs for the web project).",
    "runbook_url": "https://example.com/runbooks/api-smoke-canary-failing"
  },
  "notification_settings": {
    "receiver": "tokens-critical",
    "group_by": [
      "grafana_folder",
      "alertname"
    ],
    "group_wait": "30s",
    "group_interval": "5m",
    "repeat_interval": "4h"
  }
}

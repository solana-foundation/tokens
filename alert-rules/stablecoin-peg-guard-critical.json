{
    "uid": "tokens-stablecoin-peg-guard-critical",
    "title": "tokens-assets: stablecoin entered peg guard tier CRITICAL",
    "ruleGroup": "tokens-stablecoin-depeg",
    "folderUID": "tokens-xyz",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "0s",
    "data": [
        {
            "refId": "A",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "range",
            "relativeTimeRange": {
                "from": 900,
                "to": 0
            },
            "model": {
                "expr": "sum(count_over_time({service=~\"tokens-assets(-jobs)?-prd-us\"} | json | event=\"depeg_tier_changed\" | observer=\"peg_guard\" | new_tier=\"critical\" [15m]))",
                "queryType": "range",
                "refId": "A"
            }
        },
        {
            "refId": "B",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "B",
                "expression": "A",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "C",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "threshold",
                "refId": "C",
                "expression": "B",
                "conditions": [
                    {
                        "evaluator": {
                            "type": "gt",
                            "params": [0]
                        },
                        "operator": {
                            "type": "and"
                        },
                        "query": {
                            "params": ["B"]
                        },
                        "reducer": {
                            "type": "last",
                            "params": []
                        },
                        "type": "query"
                    }
                ]
            }
        }
    ],
    "condition": "C",
    "labels": {
        "service": "tokens-assets",
        "severity": "warning",
        "slack": "true"
    },
    "annotations": {
        "summary": "The tokens.xyz peg monitor saw a stablecoin trade more than 3% below its peg",
        "description": "The in-house peg guard (job refresh-peg-guard, observer peg_guard) observed a curated USD stablecoin enter tier critical (Birdeye price more than 3% below $1.00 with at least $100k of DEX liquidity) in the last 15 minutes. The log line (event: depeg_tier_changed) carries mint, symbol, old_tier, deviation_pct, price_usd, liquidity_usd and price_source. A caution advisory is set automatically only after the tier persists for criticalConfirmMs (10 min) and only when the peg guard is not in dry run and Webacy does not cover the mint. Slack-only at severity warning during the shadow period: once a week of production data has been reviewed and the liquidity floor and bands are tuned, flip this rule to severity critical with pagerduty: true to match stablecoin-depeg-critical.",
        "runbook_url": "https://github.com/solana-foundation/tokens/blob/main/docs/operations/asset-advisory-runbook.md#automated-depeg-advisories-tokensxyz-peg-monitor"
    }
}

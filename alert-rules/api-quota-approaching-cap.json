{
  "uid": "tokens-api-quota-approaching-cap",
  "title": "tokens-api: a project is at >80% of monthly quota",
  "ruleGroup": "tokens-api-availability",
  "folderUID": "tokens",
  "noDataState": "OK",
  "execErrState": "OK",
  "for": "15m",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "tokens-logs",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "model": {
        "expr": "max(max by(project_id) (last_over_time({service=\"tokens-api\"} | json | event=\"http_request\" | project_id != \"\" | unwrap quota_used [10m])) / max by(project_id) (last_over_time({service=\"tokens-api\"} | json | event=\"http_request\" | project_id != \"\" | unwrap quota_limit [10m])))",
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0.8
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "labels": {
    "service": "tokens-api",
    "severity": "warning",
    "pagerduty": "false",
    "slack": "true"
  },
  "annotations": {
    "summary": "A project exceeded 80% of its monthly quota",
    "description": "At least one project's quota_used / quota_limit is above 80% sustained for 15 minutes. Either someone is approaching their cap legitimately or there's runaway usage (possible bot abuse from a wallet-signup user). Open the API overview dashboard \u2192 'Quota usage % per project' panel to identify which project.",
    "runbook_url": "https://example.com/runbooks/api-quota-approaching-cap"
  },
  "notification_settings": {
    "receiver": "tokens-slack",
    "group_by": [
      "grafana_folder",
      "alertname"
    ],
    "group_wait": "30s",
    "group_interval": "5m",
    "repeat_interval": "4h"
  }
}

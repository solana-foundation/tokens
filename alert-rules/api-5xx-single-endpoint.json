{
  "uid": "tokens-api-5xx-single-endpoint",
  "title": "tokens-api: single endpoint erroring",
  "ruleGroup": "tokens-api-availability",
  "folderUID": "tokens",
  "noDataState": "OK",
  "execErrState": "OK",
  "for": "10m",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "tokens-logs",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "model": {
        "expr": "sum by (endpoint) (count_over_time({service=\"tokens-api\"} | json | event=\"http_request\" | status_class=\"5xx\" [15m]))",
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                30
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "labels": {
    "service": "tokens-api",
    "severity": "warning",
    "slack": "true"
  },
  "annotations": {
    "summary": "tokens-api: one endpoint is repeatedly 5xxing",
    "description": "A single endpoint has returned more than 30 5xx responses over the last 15 minutes (label: endpoint). Data-dependent or caller-specific breakage \u2014 investigate, but no page unless it spreads (the 5xx-ratio pager requires 2+ endpoints).",
    "runbook_url": "https://example.com/runbooks/api-5xx-single-endpoint"
  },
  "notification_settings": {
    "receiver": "tokens-slack",
    "group_by": [
      "grafana_folder",
      "alertname"
    ],
    "group_wait": "30s",
    "group_interval": "5m",
    "repeat_interval": "4h"
  }
}
